<Window x:Class="FrameTrail.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#14161B" Foreground="#E9EDF4" FontFamily="Segoe UI, Microsoft YaHei UI" Title="FrameTrail · Windows 技术预览" Width="1440" Height="920" MinWidth="1100" MinHeight="720" Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="275"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border BorderBrush="#343740" BorderThickness="0,0,0,1" Padding="20,0"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#BCE8C9" CornerRadius="8" Width="31" Height="31" Margin="0,0,10,0"><TextBlock Text="F" Foreground="#14291E" FontWeight="Bold" FontSize="23" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="FrameTrail" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="WINDOWS · 技术预览 0.1" FontSize="9" Foreground="#8894A7"/></StackPanel></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="打开项目" Click="OpenProjectClick"/><Button Content="导入视频" Click="ImportClick"/><Button Content="保存" Click="SaveClick"/><Button x:Name="ExportButton" Content="导出成片 ↗" Background="#BCE8C9" Foreground="#173222" Margin="16,3,0,3" Click="ExportClick"/></StackPanel>
   <TextBlock x:Name="ProjectTitle" Text="开始你的第一段录制" Foreground="#AFB8C9" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="24,0"/>
  </DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/><ColumnDefinition Width="242"/></Grid.ColumnDefinitions>
   <Border Background="#1C1F26" Padding="18" BorderBrush="#343740" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="录制工作台" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="采集来源" Style="{StaticResource Label}"/>
    <ComboBox x:Name="CaptureKind" SelectedIndex="0" SelectionChanged="CaptureKindChanged"><ComboBoxItem Content="整个显示器"/><ComboBoxItem Content="指定窗口"/><ComboBoxItem Content="显示器内区域"/></ComboBox>
    <ComboBox x:Name="Targets" DisplayMemberPath="Name"/><Button Content="刷新来源" Click="RefreshDevicesClick"/>
    <Button x:Name="RegionButton" Content="框选录制区域" Click="SelectRegionClick" Visibility="Collapsed"/><TextBlock x:Name="RegionLabel" FontSize="11" Foreground="#9DA8BB" TextWrapping="Wrap"/>
    <TextBlock Text="声音与帧率" Style="{StaticResource Label}"/><CheckBox x:Name="SystemSound" Content="录入系统声音"/><CheckBox x:Name="Microphone" Content="录入麦克风"/><ComboBox x:Name="MicDevices" DisplayMemberPath="Name"/><ComboBox x:Name="CaptureFps" SelectedIndex="0"><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/></ComboBox>
    <ComboBox x:Name="CaptureResolution" SelectedIndex="0"><ComboBoxItem Content="录制：最高 1080p"/><ComboBoxItem Content="录制：原始尺寸"/></ComboBox><Button x:Name="RecordButton" Content="●  开始录制（≤60 秒）" Background="#CB6863" Click="RecordClick" Margin="0,16,0,3"/><Button Content="悬浮备忘录" Click="MemoClick"/><Button Content="恢复未完成录制" Click="RecoverRecordingClick"/>
    <TextBlock Text="技术预览：单次录制最多 60 秒。&#10;长录制内存问题仍在修复。&#10;录制条可添加标记并结束录制。&#10;Ctrl+Alt+M 添加标记。&#10;完成的项目可在录制时继续编辑。" TextWrapping="Wrap" FontSize="11" Foreground="#9DA8BB" Margin="0,12,0,0"/>
    <TextBlock Text="标记" Style="{StaticResource Label}"/><ListBox x:Name="Markers" Height="90" MouseDoubleClick="MarkerJump"/><Button Content="删除选中标记" Click="DeleteMarkerClick"/>
   </StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="1" Margin="24,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Border Background="#0C0E12" CornerRadius="8" ClipToBounds="True"><Grid><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="把操作变成清晰的演示。" FontSize="25" HorizontalAlignment="Center"/><TextBlock Text="录制屏幕，跟随点击，留住重点。" Foreground="#8C97A9" Margin="0,15,0,0" HorizontalAlignment="Center"/><TextBlock Text="选择左侧来源开始录制，或导入已有视频。" Foreground="#748094" FontSize="12" Margin="0,32,0,0" HorizontalAlignment="Center"/></StackPanel><Image x:Name="PreviewImage" Stretch="Uniform" MouseLeftButtonDown="PreviewFocusClick"/><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed" MediaEnded="PlaybackEnded"/></Grid></Border>
    <DockPanel Grid.Row="1" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="⏮" Click="PreviousFrame" ToolTip="上一帧 ←"/><Button x:Name="PlayButton" Content="▶ 播放" Click="PlayClick"/><Button Content="⏭" Click="NextFrame" ToolTip="下一帧 →"/></StackPanel><TextBlock x:Name="TimeLabel" Text="00:00.000 / 00:00.000" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#A5B0C2"/></DockPanel>
   </Grid>
   <Border Grid.Column="2" Background="#1C1F26" Padding="18" BorderBrush="#343740" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="画面与运镜" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="留白" Style="{StaticResource Label}"/><Slider x:Name="PaddingSlider" Minimum="0" Maximum="0.25" Value="0.08"/><TextBlock Text="圆角" Style="{StaticResource Label}"/><Slider x:Name="RadiusSlider" Minimum="0" Maximum="0.12" Value="0.02"/><TextBlock Text="阴影" Style="{StaticResource Label}"/><Slider x:Name="ShadowSlider" Minimum="0" Maximum="1" Value="0.3"/>
    <TextBlock Text="背景色 · #RRGGBB" Style="{StaticResource Label}"/><TextBox x:Name="BackgroundColor" Text="#253B45"/><CheckBox x:Name="ShowCursor" Content="显示独立光标与点击反馈" IsChecked="True"/><Button Content="应用画面设置" Click="ApplySettingsClick"/>
    <TextBlock Text="自动运镜" Style="{StaticResource Label}"/><ComboBox x:Name="ZoomScale" SelectedIndex="1"><ComboBoxItem Content="1.3 倍"/><ComboBoxItem Content="1.6 倍"/><ComboBoxItem Content="2.0 倍"/></ComboBox><Button Content="根据点击生成运镜" Click="AutoZoomClick"/><Button Content="清除全部运镜" Click="ClearZoomClick"/>
    <TextBlock Text="手动构图：点击预览中的目标位置，在当前时间加入缩放。" FontSize="11" Foreground="#9DA8BB" TextWrapping="Wrap" Margin="0,8"/><CheckBox x:Name="ManualFocus" Content="启用点击手动构图"/>
    <TextBlock Text="光标时间偏移（毫秒）" Style="{StaticResource Label}"/><TextBox x:Name="MouseOffset" Text="0"/><Button Content="应用时间校准" Click="CalibrateClick"/>
    <TextBlock Text="导出" Style="{StaticResource Label}"/><ComboBox x:Name="Resolution" SelectedIndex="1"><ComboBoxItem Content="素材分辨率"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="1440p"/><ComboBoxItem Content="4K"/></ComboBox><ComboBox x:Name="ExportFps" SelectedIndex="0"><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/></ComboBox><CheckBox x:Name="HardwareEncoder" Content="优先硬件编码" IsChecked="True"/><Button Content="导出 M4A 音频" Click="ExportAudioClick"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#343740" BorderThickness="0,1,0,0" Background="#191C22" Padding="18,8"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <DockPanel><StackPanel Orientation="Horizontal"><Button Content="分割  S" Click="SplitClick"/><Button Content="裁去左侧" Click="TrimLeftClick"/><Button Content="裁去右侧" Click="TrimRightClick"/><Button Content="← 重排" Click="MoveLeftClick"/><Button Content="重排 →" Click="MoveRightClick"/><ComboBox x:Name="Speed" Width="78" SelectedIndex="0"><ComboBoxItem Content="1 倍"/><ComboBoxItem Content="1.5 倍"/><ComboBoxItem Content="2 倍"/><ComboBoxItem Content="4 倍"/></ComboBox><Button Content="应用速度" Click="SpeedClick"/><Button Content="恢复全片" Click="RestoreClick"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="撤销" Click="UndoClick"/><Button Content="重做" Click="RedoClick"/></StackPanel></DockPanel>
   <Slider Grid.Row="1" x:Name="Playhead" Minimum="0" Maximum="1" ValueChanged="PlayheadChanged" IsMoveToPointEnabled="True"/>
   <ListBox Grid.Row="2" x:Name="Clips" SelectionMode="Single" SelectionChanged="ClipSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="190" Height="95" Background="#304D52" CornerRadius="6" Padding="9" Margin="3"><Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.75"/><StackPanel Grid.Row="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,3,0,0" Foreground="#BBCFD2"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Canvas Grid.Row="3" x:Name="Waveform" Height="24" Background="#13191E" SizeChanged="WaveformSizeChanged"/>
   <DockPanel Grid.Row="4"><CheckBox x:Name="SnapBoundaries" Content="边界吸附" IsChecked="True" DockPanel.Dock="Right" Margin="8,4" FontSize="11"/><TextBlock x:Name="TimelineInfo" Text="选择片段后裁剪、变速或重排。所有编辑自动保存；Ctrl+Z 撤销，Ctrl+Y 重做。" Foreground="#8E99AC" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  </Grid></Border>
  <Border Grid.Row="3" Background="#111318" Padding="18,0"><DockPanel><TextBlock x:Name="Status" Text="准备就绪" VerticalAlignment="Center" Foreground="#9DA8BB"/><Button x:Name="CancelButton" Content="取消处理" Padding="10,3" DockPanel.Dock="Right" Visibility="Collapsed" Click="CancelClick"/><ProgressBar x:Name="Progress" Width="220" Height="4" Maximum="1" Margin="14,0" DockPanel.Dock="Right" Visibility="Collapsed"/></DockPanel></Border>
 </Grid>
</Window>
