<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FrameTrail.App">
  <!-- Small visible handles keep the canvas quiet; the larger transparent track
       remains available to mouse and keyboard users. -->
  <Style x:Key="QuietScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Thumb">
        <Border Background="Transparent">
          <Border x:Name="Handle" Background="{DynamicResource Secondary}" Opacity="0.4"
                  CornerRadius="2" Margin="3,0"/>
        </Border>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
            <Setter TargetName="Handle" Property="Margin" Value="0,3"/>
          </DataTrigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="0.7"/></Trigger>
          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="0.9"/></Trigger>
          <DataTrigger Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True">
            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="Handle" Property="Opacity" Value="1"/>
          </DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
        <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="24"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="QuietScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource QuietScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource QuietScrollThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource QuietScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,6"/><Setter Property="Padding" Value="0,3"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource SurfaceKeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="{DynamicResource Chrome}"
                    BorderBrush="{DynamicResource Secondary}" BorderThickness="1" VerticalAlignment="Center">
              <Grid>
                <Path x:Name="Check" Data="M 2 6 L 5 9 L 11 2.5" Stroke="{DynamicResource Chrome}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="13" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Border x:Name="Mixed" Width="8" Height="2" CornerRadius="1" Background="{DynamicResource Chrome}" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsChecked" Value="{x:Null}">
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}"/>
            <Setter TargetName="Mixed" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42"/></Trigger>
          <DataTrigger Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="Box" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="Mixed" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="Root" Property="Opacity" Value="1"/>
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True"/>
              <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="Root" Property="Opacity" Value="1"/>
            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="Mixed" Property="Background" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
          </MultiDataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style x:Key="InspectorToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="local:ControlMotion.AnimateSwitch" Value="True"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="Root" Background="Transparent" Padding="0,4">
          <Grid MinHeight="24">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
            <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <Border x:Name="SwitchTrack" Grid.Column="1" Width="36" Height="20" HorizontalAlignment="Right"
                    CornerRadius="10" Background="{DynamicResource Secondary}" BorderThickness="1" BorderBrush="Transparent">
              <Ellipse x:Name="SwitchThumb" Fill="#FAFAFA" Width="16" Height="16" Margin="1" HorizontalAlignment="Left">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.14"/></Ellipse.Effect>
              </Ellipse>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Secondary}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42"/></Trigger>
          <DataTrigger Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter TargetName="SwitchThumb" Property="Effect" Value="{x:Null}"/>
            <Setter TargetName="Root" Property="Opacity" Value="1"/>
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True"/>
              <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="Root" Property="Opacity" Value="1"/>
            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
          </MultiDataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style x:Key="TimelineToggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource SurfaceKeyboardFocus}"/>
    <Setter Property="Padding" Value="9,7"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlSurface}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource ControlSurface}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/>
    <Setter Property="Margin" Value="0,10"/><Setter Property="Height" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource SurfaceKeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Grid x:Name="Root" Background="Transparent">
          <Border x:Name="Rail" Background="{DynamicResource Hairline}" Height="3" CornerRadius="1.5" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="Filled" Background="{DynamicResource Secondary}" Command="Slider.DecreaseLarge" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="3" CornerRadius="1.5" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="24" Height="24">
              <Thumb.Template><ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                  <Ellipse x:Name="Grip" Width="16" Height="16" Fill="#FAFAFA" Stroke="{DynamicResource Hairline}" StrokeThickness="0.75">
                    <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.18"/></Ellipse.Effect>
                  </Ellipse>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource Secondary}"/></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource Accent}"/><Setter TargetName="Grip" Property="StrokeThickness" Value="1.5"/></Trigger>
                  <DataTrigger Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True">
                    <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                    <Setter TargetName="Grip" Property="Effect" Value="{x:Null}"/>
                  </DataTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource QuietScrollPage}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
          <DataTrigger Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True">
            <Setter TargetName="Root" Property="Opacity" Value="1"/>
            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="Filled" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
          </DataTrigger>
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding HighContrast, Source={StaticResource TransientPreferences}}" Value="True"/>
              <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
            </MultiDataTrigger.Conditions>
            <Setter TargetName="Root" Property="Opacity" Value="1"/>
            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter TargetName="Filled" Property="Background" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
          </MultiDataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
